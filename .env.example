HOST=0.0.0.0
PORT=8443
# Internal loopback port the plaintext Flask app binds to; pqc_tls_proxy.py
# terminates the real ML-DSA-65 mTLS connection on PORT and forwards here.
FLASK_PORT=18000

KME_ID=kme-id
ATTACHED_SAE_ID=sae-id
DEFAULT_KEY_SIZE=32
MAX_KEY_COUNT=100000
MAX_KEYS_PER_REQUEST=128
MAX_KEY_SIZE=1024
MIN_KEY_SIZE=32

KEY_GEN_SEC_TO_GEN=30

OTHER_KMES=https://127.0.0.1:8443

# All ML-DSA-65 (see certs/generate_pqc_certs.py). Two separate CAs:
#   CA_FILE       - the KME CA. Signs this KME's own KME_CERT/KME_KEY and is
#                   checked against peer-KME calls (/api/v1/kme/...).
#   RELAY_CA_FILE - a copy of the qkd_client Relay CA. Checked against
#                   relay calls (/api/v1/keys/...) -- a relay presents its
#                   one PQC identity cert, not a separate KME-facing cert.
# There is no SAE_CERT: pqc_tls_proxy.py already verifies the connecting
# client's cert against the appropriate CA above before Flask ever sees the
# request (see server/security.py).
CA_FILE=ca.crt.pem
RELAY_CA_FILE=relay_ca.crt.pem
KME_CERT=kme.crt.pem
KME_KEY=kme.key.pem