HOST=0.0.0.0
PORT=8443
# Internal loopback port the plaintext Flask app binds to; pqc_tls_proxy.py
# terminates the real ML-DSA-65 mTLS connection on PORT and forwards here.
FLASK_PORT=18000

KME_ID=kme-id
ATTACHED_SAE_ID=sae-id
DEFAULT_KEY_SIZE=32
MAX_KEY_COUNT=100000
MAX_KEYS_PER_REQUEST=128
MAX_KEY_SIZE=1024
MIN_KEY_SIZE=32

KEY_GEN_SEC_TO_GEN=30

OTHER_KMES=https://127.0.0.1:8443
# Certificate CN of each KME in OTHER_KMES, in the same order. Only these CNs
# may call /api/v1/kme/..., and these are the CNs expected when calling them.
OTHER_KME_CNS=kme-peer

# All ML-DSA-65 (see certs/generate_pqc_certs.py). One CA for every entity:
#   CA_FILE - signs this KME's own KME_CERT/KME_KEY, and every caller's cert
#             must chain to it (see pqc_tls_proxy.py).
# There is no SAE_CERT: a relay presents its one PQC identity cert. Which caller
# may use which endpoint is decided by CN, not by CA (see server/security.py).
CA_FILE=ca.crt.pem
KME_CERT=kme.crt.pem
KME_KEY=kme.key.pem